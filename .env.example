# Copia este archivo como .env.local (no se sube a git) y ajusta los valores.

# Dirección de la API para la APP NATIVA (Android). En el celular "localhost" es el propio
# teléfono, así que aquí va la IP de la PC donde corre `npm run api`, en la misma red Wi-Fi.
# Ver la IP: en Windows, comando `ipconfig` → "Dirección IPv4" del adaptador Wi-Fi.
VITE_NATIVE_API_URL=http://192.168.1.50:3001/api

# (Opcional) Forzar la API también en la versión web. Si se omite, la web usa el mismo
# host desde el que se abre la app, en el puerto 3001.
# VITE_API_URL=http://localhost:3001/api
