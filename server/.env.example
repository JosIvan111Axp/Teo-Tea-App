# Copia este archivo como .env y completa los valores. .env NO se sube a git.

# Servidor
PORT=3001
# Orígenes permitidos (separados por coma). Vacío = cualquiera (solo desarrollo).
CORS_ORIGIN=

# MySQL (usuario dedicado de la app, no root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teotea
DB_USER=teotea_app
DB_PASSWORD=

# Clave para firmar las sesiones. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Biblioteca (Project Gutenberg)
# Espejo oficial desde donde se descargan catálogo, EPUB y portadas.
GUTENBERG_MIRROR=https://gutenberg.pglaf.org
# Años tras la muerte de autor/traductor para considerar una obra de dominio público.
PUBLIC_DOMAIN_YEARS=70
